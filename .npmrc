# Published @imajin/* SDK packages (auth, config, logger, ui, …) live on GitHub
# Packages, not npmjs.org — see AGENTS.md §2. This scopes just `@imajin:*` there;
# everything else still resolves from the default registry.
@imajin:registry=https://npm.pkg.github.com

# Env-var reference only — NEVER commit a literal token here. Set NODE_AUTH_TOKEN
# locally (a GitHub PAT with `read:packages`) or in CI (GITHUB_TOKEN is enough on
# GitHub Actions, scoped to `packages: read`). See README.md "Consuming @imajin/*".
//npm.pkg.github.com/:_authToken=${NODE_AUTH_TOKEN}
